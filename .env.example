# Copy this file to `.env.local` and fill in the values.
# `.env.local` must never be committed.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Giphy → https://developers.giphy.com/dashboard/
# Server-only variable: never prefix it with NEXT_PUBLIC_.
GIPHY_API_KEY=

# --- Push notifications (optional) ---------------------------------------
# Generate the key pair with: npx web-push generate-vapid-keys
# Without these keys, the "Turn on notifications" button doesn't show up and
# the rest of the app works normally.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
